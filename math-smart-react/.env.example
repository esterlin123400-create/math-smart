# Supabase Client Configuration (Public Anon Key is safe for client when RLS is enabled)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini AI Server-Side Configuration (Set ONLY on Vercel / Server Environment — NEVER prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key-here
